#!/bin/zsh
# Snug 的开发与发版命令。出包相关的事都从这一个入口走，不另外散脚本：
#   scripts/snug help
#
# 版本号只从仓库根目录的 VERSION 读。本机才有的东西（签名证书、公证档案、发版用的 GitHub 账号、
# 国内源的桶和密钥从哪来）放在不进 git 的 .machine.env（样板见 .machine.env.example），同名环境变量优先。
#
# 发版的约定（照 SpeakMore 的 ship）：
# - 两个下载地址：GitHub Release，和国内源（腾讯云 COS + CDN，国内下载快，官网也从这里取）
# - 发过的版本不改：GitHub 上这个版本已经公开、包又和本机的不一样，就拒绝；国内源同名的包内容不一样也拒绝。要改就升版本号
# - 断了别重打：dist/<版本>/ 里留着打好的包和它出自哪个提交，ship 重跑时直接用，只补没做完的那一步
set -euo pipefail
cd "${0:A:h}/.."

readonly BUNDLE_ID="com.zephyr4123.snug"
readonly APP="build/Snug.app"
readonly REPO_URL="https://github.com/zephyr4123/snug"
# gh 的 release 命令都发到这个仓库。不写明时 gh 自己从 git 远端里挑，有 upstream 就挑 upstream：
# 2.0.0 发版时它挑中了原作者的 aoyamashou/UUyc-companion，靠 --verify-tag 才没发过去
export GH_REPO="${REPO_URL#https://github.com/}"
# 国内源：桶和 SpeakMore 共用，Snug 的都在 snug/ 下，网址的路径就是桶里的对象名（摆法见「国内源」一节）
readonly COS_PREFIX="snug"
readonly DOWNLOAD_BASE="https://dl.zephyrxiang.com/$COS_PREFIX"
# 通用二进制：Apple 芯片和 Intel 一个包。install 也打同样的，自己测的就是要发的
readonly ARCHS=(--arch arm64 --arch x86_64)

# MARK: 小工具

die() { print -u2 -- "❌ $*"; exit 1; }
warn() { print -u2 -- "⚠️  $*"; }
step() { print -- "==> $*"; }

usage() {
  cat <<'USAGE'
用法：scripts/snug <命令>

  check     构建全部产物，跑全部测试（门禁）
  app       打 build/Snug.app 并签名：有 Developer ID 证书就用它，没有就 ad-hoc
  install   打 App，装进「应用程序」并打开（先正常退出正在跑的 Snug，窗口会先放回原处）
  dist      打可分发的安装包 dist/<版本>/Snug-<版本>.dmg：Developer ID 签名，App 和 dmg 各自公证、钉票据；
            再把公证过的 App 打成应用内更新用的 Snug-<版本>.pack
  ship      发版：把关 → check → dist → 写 update.json（更新日志取自标签说明）→ GitHub Release 草稿、传包 →
            公开 → 传国内源 → 两边都从下载地址核对
  mirror    把 GitHub 上已经公开的版本补传到国内源：scripts/snug mirror 2.0.0
  media     把 README 用的图片、视频传到国内源，打出地址：scripts/snug media <文件…>
  help      显示这段说明

发版：改好 VERSION 并提交，打带说明的同名标签推上去，再 ship（Release 的说明取自标签说明）：
  git tag -a v2.0.0 -m "…" && git push origin v2.0.0
  scripts/snug ship
USAGE
}

# .machine.env：只认 KEY=VALUE 行，开头的 ~ 展开成家目录；环境里已经有的不覆盖
load_machine_env() {
  [[ -f .machine.env ]] || return 0
  local key value
  while IFS='=' read -r key value; do
    [[ $key =~ '^[A-Z_][A-Z0-9_]*$' ]] || continue
    value="${value%\"}"; value="${value#\"}"
    [[ $value == "~/"* ]] && value="$HOME/${value#\~/}"
    [[ -n ${(P)key:-} || -z $value ]] || export "$key=$value"
  done < .machine.env
}

read_version() {
  local version; version="$(tr -d '[:space:]' < VERSION)"
  [[ $version =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]] || die "VERSION 里的版本号不合法：「$version」"
  print -- "$version"
}

# MARK: 签名

IDENTITY=""        # 证书 SHA-1 或名字；空 = ad-hoc
DEVELOPER_ID=0     # 1 = Developer ID Application：带 hardened runtime 和时间戳（公证要求）

# 用哪张证书：MAC_SIGNING_IDENTITY（"-" 表示 ad-hoc）；没设就用钥匙串里唯一那张 Developer ID Application；都没有就 ad-hoc。
# 日志里只打 SHA-1 前 8 位：证书名里带着人名和团队号
resolve_identity() {
  local all; all="$(security find-identity -v -p codesigning 2>/dev/null || true)"
  if [[ -n ${MAC_SIGNING_IDENTITY:-} ]]; then
    if [[ $MAC_SIGNING_IDENTITY == "-" ]]; then
      IDENTITY=""
    else
      [[ $all == *"$MAC_SIGNING_IDENTITY"* ]] || die "钥匙串里找不到 MAC_SIGNING_IDENTITY 指定的有效证书"
      IDENTITY="$MAC_SIGNING_IDENTITY"
    fi
  else
    local found=("${(@f)$(print -r -- "$all" | awk '/"Developer ID Application: /{print $2}')}")
    found=(${found:#})
    case ${#found} in
      0) IDENTITY="" ;;
      1) IDENTITY="${found[1]}" ;;
      *) die "钥匙串里有 ${#found} 张 Developer ID Application 证书，请在 .machine.env 里用 MAC_SIGNING_IDENTITY 指定一张" ;;
    esac
  fi
  DEVELOPER_ID=0
  if [[ -n $IDENTITY ]]; then
    local line
    for line in "${(@f)all}"; do
      if [[ $line == *"$IDENTITY"* && $line == *'"Developer ID Application: '* ]]; then DEVELOPER_ID=1; fi
    done
  fi
  return 0
}

describe_identity() {
  if [[ -z $IDENTITY ]]; then print -- "ad-hoc"
  elif (( DEVELOPER_ID )); then print -- "Developer ID（${IDENTITY[1,8]}…）"
  else print -- "${IDENTITY[1,8]}…"; fi
}

# 签名。时间戳服务偶尔连不上（SpeakMore 0.17.2 连着两次断在这里）：只对这一种错重签，最多 3 次
sign() {
  local target=$1
  local flags=(--force --sign "${IDENTITY:--}")
  (( DEVELOPER_ID )) && flags+=(--timestamp)
  [[ -d $target ]] && { flags+=(--identifier "$BUNDLE_ID"); (( DEVELOPER_ID )) && flags+=(--options runtime); }
  local err; err="$(mktemp)"
  local attempt
  for attempt in 1 2 3; do
    if codesign "${flags[@]}" "$target" 2>"$err"; then rm -f "$err"; return 0; fi
    if (( attempt == 3 )) || ! grep -q "timestamp service is not available" "$err"; then
      cat "$err" >&2; rm -f "$err"
      die "签名失败：$target"
    fi
    warn "codesign：时间戳服务没连上（第 $attempt 次），5 秒后重签"
    sleep 5
  done
}

# 可分发的签名：Developer ID、带时间戳、App 还要 hardened runtime
verify_distribution_signature() {
  local target=$1 details
  codesign --verify --strict --deep "$target" || die "签名校验没过：$target"
  details="$(codesign -dvv "$target" 2>&1)"
  [[ $details == *"Authority=Developer ID Application:"* && $details == *"Timestamp="* ]] \
    || die "$target 不是带时间戳的 Developer ID 签名"
  if [[ -d $target && $details != *"(runtime)"* ]]; then die "$target 没开 hardened runtime"; fi
}

# MARK: 公证

# 交给苹果公证并等结果。没拿到结论（连不上、超时）隔 30 秒重交，最多 3 次；
# 苹果给了不通过的结论就不重交，把问题清单打出来
notarize() {
  local file=$1 out id="" verdict="" attempt
  for attempt in 1 2 3; do
    out="$(xcrun notarytool submit "$file" --keychain-profile "$MAC_NOTARY_PROFILE" --wait --output-format json || true)"
    id="$(print -r -- "$out" | plutil -extract id raw -o - - 2>/dev/null || true)"
    verdict="$(print -r -- "$out" | plutil -extract status raw -o - - 2>/dev/null || true)"
    [[ -n $id && -n $verdict ]] && break
    (( attempt < 3 )) || die "交给苹果公证 3 次都没拿到结果：${file:t}"
    warn "公证没拿到结果（第 $attempt 次，共 3 次），30 秒后重交"
    sleep 30
  done
  if [[ $verdict == "Accepted" ]]; then
    print -- "公证通过：${file:t}（$id）"
    return 0
  fi
  xcrun notarytool log "$id" --keychain-profile "$MAC_NOTARY_PROFILE" >&2 || true
  die "${file:t} 没过公证：$verdict（编号 $id）"
}

require_distribution_setup() {
  (( DEVELOPER_ID )) || die "可分发的包要用 Developer ID Application 证书签名，钥匙串里没有（或 MAC_SIGNING_IDENTITY 指的不是）"
  [[ -n ${MAC_NOTARY_PROFILE:-} ]] || die "没配公证档案。先把 App Store Connect 的 API key 存进钥匙串，再把档案名写进 .machine.env：
    xcrun notarytool store-credentials <档案名> --key AuthKey_<Key ID>.p8 --key-id <Key ID> --issuer <Issuer ID>
    echo 'MAC_NOTARY_PROFILE=<档案名>' >> .machine.env"
}

# 公证要读钥匙串里的档案；屏幕锁上后档案读不出来，公证中途会失败。打包期间不让机器睡、不让屏幕锁
keep_awake() { caffeinate -d -i -w $$ & }

# MARK: 打包

write_info_plist() {
  local version=$1
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>${BUNDLE_ID}</string>
  <key>CFBundleName</key><string>Snug</string>
  <key>CFBundleDisplayName</key><string>Snug</string>
  <key>CFBundleExecutable</key><string>Snug</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>${version}</string>
  <key>CFBundleVersion</key><string>${version}</string>
  <key>CFBundleDevelopmentRegion</key><string>zh_CN</string>
  <key>CFBundleLocalizations</key><array><string>zh-Hans</string><string>en</string></array>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSHumanReadableCopyright</key><string>© 2026 AoyamaShou, © 2026 zephyr4123 · MIT</string>
</dict>
</plist>
PLIST
}

# build/Snug.app：切模式的帮手进程就是 Snug 自己（带 --set-mode 运行），不另外打包
build_app() {
  local version; version="$(read_version)"
  step "编译（release，arm64 + x86_64）"
  swift build -c release --product Snug "${ARCHS[@]}"
  local bin; bin="$(swift build -c release "${ARCHS[@]}" --show-bin-path)"
  step "组装 $APP（版本 $version）"
  rm -rf "$APP"
  mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
  cp "$bin/Snug" "$APP/Contents/MacOS/Snug"
  # PermissionFlow 的资源包（本地化文案等），它在 Contents/Resources 里找
  cp -R "$bin/PermissionFlow_PermissionFlow.bundle" "$APP/Contents/Resources/"
  # App 图标；界面里的其它图标都是 SF Symbols
  cp Assets/AppIcon/AppIcon.icns "$APP/Contents/Resources/"
  write_info_plist "$version" > "$APP/Contents/Info.plist"
  step "签名：$(describe_identity)"
  sign "$APP"
  codesign --verify --strict --deep "$APP" || die "签名校验没过：$APP"
  (( DEVELOPER_ID )) || warn "ad-hoc 签名：每次重新打包后辅助功能授权都会失效，也不能发给别人"
}

# App 装进 dmg：打开后左边是 Snug，右边是「应用程序」的替身，拖过去就装好
make_dmg() {
  local dmg=$1 stage; stage="$(mktemp -d)"
  ditto "$APP" "$stage/Snug.app"
  ln -s /Applications "$stage/Applications"
  # ULMO（LZMA）比默认的 UDZO 小，macOS 10.15 起都打得开
  hdiutil create -quiet -volname Snug -srcfolder "$stage" -format ULMO -ov "$dmg"
  rm -rf "$stage"
}

# MARK: 国内源（腾讯云 COS + CDN）
#
# 桶私有，只让 CDN 读；都在 snug/ 下：
#   v<版本>/Snug-<版本>.dmg、.sha256    发过就不改，缓存一年
#   v<版本>/Snug-<版本>.pack、update.json 应用内更新：按块打的包和说明它的 update.json（Sources/SnugRelease）
#   latest/Snug.dmg                     固定的「最新版」地址（README、官网用）：发版时换成新包，不往旧版本换；
#                                       缓存 5 分钟，下载下来的文件名带版本号
#   latest/update.json                  App 启动时查它：同样只往新版本换、缓存 5 分钟
#   media/<名字>.<指纹>.<后缀>           README 的图片、视频：名字带内容指纹，内容变了地址跟着变，缓存一年
# 每个对象带 x-cos-meta-sha256：重跑时内容一样就跳过，不一样就拒绝（不会悄悄盖掉发过的东西）

readonly COS_PYTHON=".venv/bin/python"
readonly IMMUTABLE="public, max-age=31536000, immutable"

# .venv 不进 git，依赖照 scripts/cos-requirements.txt 钉死的版本装；没装好就装
ensure_cos_python() {
  [[ -x $COS_PYTHON ]] && "$COS_PYTHON" -c 'import qcloud_cos' 2>/dev/null && return 0
  step "准备传国内源用的 Python 环境（.venv）"
  python3 -m venv .venv
  .venv/bin/pip install -q --disable-pip-version-check -r scripts/cos-requirements.txt
}

# 传之前查齐：桶、地域、密钥从哪来。ship 在把关时就查，别等 GitHub 那边发完才发现传不了
require_cos_setup() {
  [[ -n ${COS_BUCKET:-} && -n ${COS_REGION:-} ]] \
    || die "没配国内源的桶：照 .machine.env.example 在 .machine.env 里填 COS_BUCKET、COS_REGION"
  [[ -n ${TENCENTCLOUD_SECRET_ID:-} && -n ${TENCENTCLOUD_SECRET_KEY:-} ]] && return 0
  [[ -n ${COS_SECRETS_LOADER:-} && -n ${COS_CREDENTIAL:-} ]] \
    || die "环境里没有腾讯云的密钥，.machine.env 里的 COS_SECRETS_LOADER 或 COS_CREDENTIAL 也是空的"
  [[ -f $COS_SECRETS_LOADER ]] || die "找不到密钥加载器 $COS_SECRETS_LOADER"
}

# 跑一次 COS 小工具（cos_tool_source）。密钥只进这一个子进程：环境里已经有 TENCENTCLOUD_SECRET_ID / KEY 就直接用，
# 否则用 .machine.env 里的加载器和凭据名（withkey 只把密钥喂给它启动的那条命令）
cos() {
  require_cos_setup
  ensure_cos_python
  local code; code="$(cos_tool_source)"
  if [[ -n ${TENCENTCLOUD_SECRET_ID:-} && -n ${TENCENTCLOUD_SECRET_KEY:-} ]]; then
    "$COS_PYTHON" -c "$code" "$@"
  else
    ( source "$COS_SECRETS_LOADER"
      (( $+functions[withkey] )) || die "加载器 $COS_SECRETS_LOADER 里没有 withkey"
      withkey "$COS_CREDENTIAL" "$COS_PYTHON" -c "$code" "$@" )
  fi
}

cos_tool_source() {
  cat <<'PY'
# 用法（只由 scripts/snug 调，桶、地域、密钥都在环境变量里）：
#   put   <本地文件> <对象名> <缓存头>                       发过就不改的对象
#   alias <本地文件> <对象名> <缓存头> <版本> [下载文件名]     「最新版」地址：只往新版本换
import hashlib, os, sys
from qcloud_cos import CosConfig, CosS3Client
from qcloud_cos.cos_exception import CosServiceError

TYPES = {".dmg": "application/x-apple-diskimage", ".sha256": "text/plain; charset=utf-8",
         ".pack": "application/octet-stream", ".json": "application/json; charset=utf-8",
         ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".webp": "image/webp",
         ".gif": "image/gif", ".mp4": "video/mp4"}
env = os.environ
BUCKET = env["COS_BUCKET"]
client = CosS3Client(CosConfig(Region=env["COS_REGION"], SecretId=env["TENCENTCLOUD_SECRET_ID"],
                               SecretKey=env["TENCENTCLOUD_SECRET_KEY"]))

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()

def meta(key):
    """对象的 x-cos-meta-*（去掉前缀、键名小写）；对象不在返回 None"""
    try:
        headers = client.head_object(Bucket=BUCKET, Key=key)
    except CosServiceError as error:
        if error.get_status_code() == 404:
            return None
        raise
    prefix = "x-cos-meta-"
    return {k.lower()[len(prefix):]: v for k, v in headers.items() if k.lower().startswith(prefix)}

def upload(path, key, cache, digest, extra=None, disposition=None):
    fields = {"sha256": digest, **(extra or {})}
    options = {"ContentType": TYPES[os.path.splitext(key)[1].lower()], "CacheControl": cache,
               "Metadata": {f"x-cos-meta-{k}": v for k, v in fields.items()}}
    if disposition:
        options["ContentDisposition"] = disposition
    client.upload_file(Bucket=BUCKET, Key=key, LocalFilePath=path, **options)
    if (meta(key) or {}).get("sha256") != digest:
        sys.exit(f"传完回读核对不上：{key}")

def put(path, key, cache):
    digest = sha256(path)
    current = meta(key)
    if current is not None:
        if current.get("sha256") == digest:
            print(f"已在上面，跳过：{key}")
            return
        sys.exit(f"{key} 已经在国内源上，内容不一样：发过的不改，要改就换名字（安装包就升版本号）")
    upload(path, key, cache, digest)
    print(f"已传：{key}")

def alias(path, key, cache, version, filename=None):
    digest = sha256(path)
    current = meta(key)
    if current is not None:
        now = current.get("version", "0.0.0")
        if tuple(map(int, now.split("."))) > tuple(map(int, version.split("."))):
            print(f"最新版地址已经是更新的 {now}，不往回换")
            return
        if now == version and current.get("sha256") == digest:
            print(f"最新版地址已经是 {version}，跳过")
            return
    upload(path, key, cache, digest, {"version": version}, filename and f'attachment; filename="{filename}"')
    print(f"最新版地址换成了 {version}：{key}")

command, *args = sys.argv[1:]
{"put": put, "alias": alias}[command](*args)
PY
}

# 从下载地址拉下来比校验值：GitHub 和国内源都这样核对。
# 网络偶尔断一下（实测本机到 CDN 零星有 SSL 握手失败，curl 35）就重试，最多 3 次
verify_download() {
  local url=$1 want=$2 got
  got="$(curl -fsSL --retry 3 --retry-all-errors --retry-delay 2 "$url" | shasum -a 256 | cut -d ' ' -f 1)" || die "下载不了 $url"
  [[ $got == "$want" ]] || die "$url 上的和本机的不一样（$got ≠ $want）"
  print -- "下载地址核对过：$url"
}

# <目录> 里的 Snug-<版本>.dmg 和 .sha256 传到国内源、从下载地址核对，再把「最新版」地址换成它
publish_cos() {
  local version=$1 dir=$2 name="Snug-$1.dmg"
  local sum; sum="$(cut -d ' ' -f 1 < "$dir/$name.sha256")"
  step "传到国内源 $DOWNLOAD_BASE/v$version/"
  cos put "$dir/$name" "$COS_PREFIX/v$version/$name" "$IMMUTABLE"
  cos put "$dir/$name.sha256" "$COS_PREFIX/v$version/$name.sha256" "$IMMUTABLE"
  verify_download "$DOWNLOAD_BASE/v$version/$name" "$sum"
  step "国内源的最新版地址"
  cos alias "$dir/$name" "$COS_PREFIX/latest/Snug.dmg" "public, max-age=300" "$version" "$name"
  # 这个地址会换内容，CDN 节点上可能还留着 5 分钟以内的旧包：上面已经回读源站核对过，这里不从 CDN 核对
  print -- "最新版地址：$DOWNLOAD_BASE/latest/Snug.dmg（CDN 节点最多 5 分钟后换上）"
}

# <目录> 里应用内更新用的 Snug-<版本>.pack 和 update.json 传到国内源、从下载地址核对，再把 latest/update.json 换成它。
# 只有 2.1.0 起的版本有（mirror 补传的老版本没有）
publish_cos_update() {
  local version=$1 dir=$2 name
  step "传应用内更新到国内源"
  for name in "Snug-$version.pack" update.json; do
    cos put "$dir/$name" "$COS_PREFIX/v$version/$name" "$IMMUTABLE"
    verify_download "$DOWNLOAD_BASE/v$version/$name" "$(shasum -a 256 "$dir/$name" | cut -d ' ' -f 1)"
  done
  cos alias "$dir/update.json" "$COS_PREFIX/latest/update.json" "public, max-age=300" "$version"
}

# 发版工具（Sources/SnugRelease）：打更新包、写 update.json
release_tool() { swift run -c release --quiet snug-release "$@"; }

# MARK: 命令

cmd_check() {
  step "swift build（全部产物）"
  swift build
  step "swift test"
  swift test
  print -- "✅ check 通过"
}

cmd_app() {
  resolve_identity
  build_app
  print -- "✅ $APP（$(describe_identity)）"
}

cmd_install() {
  resolve_identity
  build_app
  local target="/Applications/Snug.app"
  local pids=(${(f)"$(pgrep -f "^$target/Contents/MacOS/Snug" || true)"})
  if (( ${#pids} )); then
    # SIGTERM 走 Snug 自己的退出收尾：窗口放回原处、撤掉手机屏，再退出
    step "退出正在跑的 Snug（pid ${pids[*]}）"
    kill -TERM "${pids[@]}"
    # 最多等 20 秒：要长过 Snug 的退出收尾上限（QuitFlow.userQuitTimeout，15 秒），不然它还在放回窗口就被判成没退出
    local waited=0
    while kill -0 "${pids[@]}" 2>/dev/null; do
      (( waited < 40 )) || die "Snug 20 秒内没退出，没有替换"
      sleep 0.5; (( waited += 1 ))
    done
  fi
  step "装进 $target"
  rm -rf "$target"
  ditto "$APP" "$target"
  open "$target"
  print -- "✅ 已安装并打开 $target（$(describe_identity)）"
}

# 打可分发的包，产物在 dist/<版本>/：dmg、它的 .sha256、BUILT_FROM（出自哪个提交；工作区有改动时带 -dirty，ship 不会用）
cmd_dist() {
  resolve_identity
  require_distribution_setup
  keep_awake
  local version; version="$(read_version)"
  local out="dist/$version" dmg="dist/$version/Snug-$version.dmg"
  local commit; commit="$(git rev-parse HEAD)"
  [[ -z "$(git status --porcelain)" ]] || { commit="$commit-dirty"; warn "工作区有没提交的改动：这个包只能自己用，ship 不会用它"; }
  rm -rf "$out"
  mkdir -p "$out"

  build_app
  verify_distribution_signature "$APP"
  step "公证 App"
  local zip="$out/Snug-$version-notarize.zip"
  ditto -c -k --keepParent "$APP" "$zip"
  notarize "$zip"
  rm -f "$zip"
  xcrun stapler staple -q "$APP"
  xcrun stapler validate -q "$APP"
  spctl --assess --type execute "$APP" || die "Gatekeeper 不认 $APP"

  step "应用内更新包"
  release_tool pack "$APP" "$version" "$out"

  step "打 dmg"
  make_dmg "$dmg"
  sign "$dmg"
  verify_distribution_signature "$dmg"
  step "公证 dmg"
  notarize "$dmg"
  xcrun stapler staple -q "$dmg"
  xcrun stapler validate -q "$dmg"
  # 双击打开 dmg 时系统做的就是这一项检查
  spctl --assess --type open --context context:primary-signature "$dmg" || die "Gatekeeper 不认 $dmg"

  (cd "$out" && shasum -a 256 "${dmg:t}" > "${dmg:t}.sha256")
  print -- "$commit" > "$out/BUILT_FROM"
  print -- "✅ $dmg（$(describe_identity)，已公证）"
}

# 本地的包能不能直接拿去发：出自 HEAD、工作区当时干净、校验值对得上
dist_is_current() {
  local version=$1 out="dist/$1"
  [[ -f $out/BUILT_FROM && -f $out/Snug-$version.dmg && -f $out/Snug-$version.dmg.sha256 ]] || return 1
  [[ -f $out/Snug-$version.pack && -f $out/update-package.json ]] || return 1
  [[ "$(cat "$out/BUILT_FROM")" == "$(git rev-parse HEAD)" ]] || return 1
  (cd "$out" && shasum -a 256 -c -s "Snug-$version.dmg.sha256")
}

check_github_account() {
  command -v gh >/dev/null || die "没装 gh（GitHub 命令行）"
  local login; login="$(gh api user --jq .login 2>/dev/null)" || die "gh 没登录（或 GH_CONFIG_DIR 指的配置目录里没有登录）"
  if [[ -n ${GITHUB_ACCOUNT:-} && $login != "$GITHUB_ACCOUNT" ]]; then
    die "gh 现在是 $login，发版要用 $GITHUB_ACCOUNT：在 .machine.env 里把 GH_CONFIG_DIR 指向只登录了 $GITHUB_ACCOUNT 的配置目录"
  fi
}

cmd_ship() {
  local version; version="$(read_version)"
  local tag="v$version" dmg_name="Snug-$version.dmg"

  step "把关"
  [[ -z "$(git status --porcelain)" ]] || die "工作区有没提交的改动：发出去的会和标签对不上"
  # grep 不用 -q：提前退出会让前面的 git 吃 SIGPIPE，pipefail 下误判成失败
  git tag --points-at HEAD | grep -x "$tag" >/dev/null || die "HEAD 上没有标签 $tag（VERSION 里是 $version）"
  [[ "$(git cat-file -t "$tag")" == "tag" ]] || die "$tag 是轻量标签：Release 的说明取自标签说明，请用 git tag -a 重打"
  local remote; remote="$(git ls-remote origin "refs/tags/$tag^{}" | cut -f 1)"
  [[ $remote == "$(git rev-parse HEAD)" ]] || die "标签 $tag 还没推到 GitHub，或者那边指的不是这个提交"
  check_github_account
  require_cos_setup

  # 已经公开的版本不改；草稿可以接着传
  local state=""
  state="$(gh release view "$tag" --json isDraft --jq 'if .isDraft then "draft" else "published" end' 2>/dev/null || true)"

  if dist_is_current "$version"; then
    step "dist/$version 里的包出自这个提交，直接用"
  else
    [[ $state != "published" ]] || die "$tag 已经公开，本机却没有出自这个提交的包：发过的版本不能改，要改就升版本号"
    cmd_check
    cmd_dist
  fi
  local dmg="dist/$version/$dmg_name"
  step "update.json"
  release_tool feed "$version" "dist/$version"
  local assets=("$dmg" "$dmg.sha256" "dist/$version/Snug-$version.pack" "dist/$version/update.json")

  case $state in
    published)
      step "$tag 已经公开，只核对下载地址" ;;
    draft)
      step "接着传到已有的草稿 $tag"
      gh release upload "$tag" "${assets[@]}" --clobber ;;
    *)
      step "建 GitHub Release 草稿 $tag"
      gh release create "$tag" "${assets[@]}" --draft --verify-tag --notes-from-tag --title "Snug $version" ;;
  esac
  if [[ $state != "published" ]]; then
    step "公开 $tag"
    gh release edit "$tag" --draft=false --latest
  fi

  step "从 GitHub 的下载地址核对"
  local asset
  for asset in "${assets[@]:#*.sha256}"; do
    verify_download "$REPO_URL/releases/download/$tag/${asset:t}" "$(shasum -a 256 "$asset" | cut -d ' ' -f 1)"
  done

  publish_cos "$version" "dist/$version"
  publish_cos_update "$version" "dist/$version"
  print -- "✅ Snug $version 已发布：$REPO_URL/releases/tag/$tag · 国内源 $DOWNLOAD_BASE/v$version/$dmg_name"
}

# 把 GitHub 上已经公开的版本补传到国内源：包从 GitHub 下载、比过校验值再传，两边是同一个文件
cmd_mirror() {
  local version="${1#v}"
  [[ $version =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]] || die "用法：scripts/snug mirror <版本>，比如 scripts/snug mirror 2.0.0"
  local tag="v$version" name="Snug-$version.dmg"
  check_github_account
  require_cos_setup
  [[ "$(gh release view "$tag" --json isDraft --jq .isDraft 2>/dev/null)" == "false" ]] \
    || die "GitHub 上没有已经公开的 $tag：国内源只补传公开了的版本，新版本用 ship 发"
  local dir; dir="$(mktemp -d)"
  step "从 GitHub 下载 $tag 的安装包"
  gh release download "$tag" --pattern "$name" --pattern "$name.sha256" --dir "$dir"
  (cd "$dir" && shasum -a 256 -c -s "$name.sha256") || die "下载下来的 $name 和 GitHub 上的校验值对不上"
  publish_cos "$version" "$dir"
  rm -rf "$dir"
  print -- "✅ Snug $version 已在国内源：$DOWNLOAD_BASE/v$version/$name"
}

# README 用的图片、视频传到国内源 media/ 下，打出地址。文件名就是地址里的名字（后面自动加内容指纹）
cmd_media() {
  (( $# )) || die "用法：scripts/snug media <文件…>（文件名用小写字母、数字和连字符，比如 hero-claude-code.png）"
  local tmp; tmp="$(mktemp -d)"
  local file stem ext src sum key urls=() tag=()
  for file in "$@"; do
    [[ -f $file ]] || die "没有这个文件：$file"
    stem="${file:t:r}" ext="${file:e:l}"
    [[ $stem =~ '^[a-z0-9-]+$' ]] || die "文件名只用小写字母、数字和连字符：${file:t}"
    case $ext in
      png|jpg|jpeg|webp|gif) src="$file" ;;
      mp4|mov)
        # 只换封装、不重新编码：moov 挪到文件头，网页不用整个下完就能播；顺手去掉录制时间、地点这些元数据。
        # HEVC 要标成 hvc1，Safari 才肯播
        command -v ffmpeg >/dev/null || die "传视频要用 ffmpeg 重新封装，没装：brew install ffmpeg"
        tag=()
        [[ "$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$file")" == hevc ]] && tag=(-tag:v hvc1)
        ext=mp4 src="$tmp/$stem.mp4"
        ffmpeg -v error -y -i "$file" -map 0 -c copy "${tag[@]}" -map_metadata -1 -movflags +faststart "$src" ;;
      *) die "只传图片（png、jpg、webp、gif）和视频（mp4、mov）：${file:t}" ;;
    esac
    sum="$(shasum -a 256 "$src" | cut -d ' ' -f 1)"
    key="media/$stem.${sum[1,8]}.$ext"
    cos put "$src" "$COS_PREFIX/$key" "$IMMUTABLE"
    verify_download "$DOWNLOAD_BASE/$key" "$sum"
    urls+=("$DOWNLOAD_BASE/$key")
  done
  rm -rf "$tmp"
  print -- "✅ 已在国内源："
  print -l -- "${urls[@]}"
}

# MARK: 入口

load_machine_env
case "${1:-help}" in
  check) cmd_check ;;
  app) cmd_app ;;
  install) cmd_install ;;
  dist) cmd_dist ;;
  ship) cmd_ship ;;
  mirror) cmd_mirror "${2:-}" ;;
  media) shift; cmd_media "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "不认识的命令：$1" ;;
esac
